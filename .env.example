# ResearchOps configuration. This file is the single place to change behaviour.
# Copy to .env and fill in secrets. Never commit .env.

# --- Application ---
RESEARCHOPS_ENVIRONMENT=development
RESEARCHOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication ---
# Required, at least 32 characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
RESEARCHOPS_JWT_SECRET=
RESEARCHOPS_ACCESS_TOKEN_MINUTES=30
RESEARCHOPS_REFRESH_TOKEN_DAYS=30
# A just-rotated refresh token stays usable this long, so two open tabs do not log each other out.
RESEARCHOPS_REFRESH_REUSE_GRACE_SECONDS=30
# Must be true in production (HTTPS).
RESEARCHOPS_COOKIE_SECURE=false
RESEARCHOPS_PASSWORD_MIN_LENGTH=8
RESEARCHOPS_LOGIN_MAX_FAILURES=5
RESEARCHOPS_LOGIN_LOCK_MINUTES=15

# --- Storage (relative paths resolve from the project root) ---
RESEARCHOPS_AUTH_DB_PATH=backend/data/auth.db
RESEARCHOPS_RESEARCH_DB_PATH=backend/data/research.db
RESEARCHOPS_REPORT_DIR=backend/data/reports

# --- Credits ---
# Credits each user may spend. Raising this also gives existing users the extra credits.
RESEARCHOPS_USER_CREDITS=5
RESEARCHOPS_RESEARCH_CREDIT_COST=1
# Reports use no credits, but each one calls a model, so they are capped per research run.
RESEARCHOPS_MAX_REPORTS_PER_RUN=3

# --- Reports ---
# Page count used when the user does not choose one, and the most they may request.
RESEARCHOPS_DEFAULT_REPORT_PAGES=5
RESEARCHOPS_MAX_REPORT_PAGES=20
# Long reports need longer model calls than research steps do.
RESEARCHOPS_REPORT_LLM_TIMEOUT_SECONDS=120
RESEARCHOPS_REPORT_TOKEN_BUDGET=300000
RESEARCHOPS_REPORT_MAX_RUNTIME_SECONDS=420

# --- Models (format provider:model) ---
# Auto is the default in the UI: it tries the primary model, then each fallback in order.
RESEARCHOPS_PRIMARY_MODEL=nebius:nvidia/Nemotron-3_5-Lightning
RESEARCHOPS_FALLBACK_MODELS=gemini:gemini-3.8-flash
# Also selectable in the picker. Auto does not use them.
RESEARCHOPS_EXTRA_MODELS=nebius:openai/gpt-oss-120b,openai:gpt-4.1
RESEARCHOPS_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
RESEARCHOPS_LLM_TIMEOUT_SECONDS=60

# --- API keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=
NEBIUS_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=

# --- LangSmith tracing ---
RESEARCHOPS_LANGSMITH_TRACING=false
RESEARCHOPS_LANGSMITH_PROJECT=researchops

# --- Research guardrails ---
RESEARCHOPS_MAX_QUESTION_CHARS=2000
RESEARCHOPS_MAX_SEARCHES=8
RESEARCHOPS_MAX_SOURCES=15
RESEARCHOPS_MAX_PAGES=10
RESEARCHOPS_MAX_ITERATIONS=5
RESEARCHOPS_MAX_TOKEN_BUDGET=100000
RESEARCHOPS_MAX_RUNTIME_SECONDS=240
RESEARCHOPS_MAX_SOURCES_PER_DOMAIN=3
RESEARCHOPS_MAX_CHARS_PER_SOURCE=6000
RESEARCHOPS_FETCH_TIMEOUT_SECONDS=10
RESEARCHOPS_MAX_FETCH_BYTES=3000000
